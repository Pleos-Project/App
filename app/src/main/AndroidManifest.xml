<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pleos Connect(Android Automotive) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Vehicle SDK 권한: 사용하는 도메인만 선언 (pleos.car.permission.{상수명})
         CAR_DOORS = 도어, CAR_INFO = 차량 정보·디스플레이, CAR_DRIVE = 주행·기어·브레이크 등 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pleos_App">

        <!-- 주행 중에도 보여도 되는 화면만 distractionOptimized=true 로 둔다.
             주행 규제 가이드: CarUxRestrictions 연동 필요 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
